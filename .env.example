# Copie para .env e preencha. O .env nao vai para o git.
#
# EXPO_PUBLIC_* e embutido no pacote em tempo de build. A chave anonima do
# Supabase e publica por natureza -- quem separa uma conta da outra e a Row
# Level Security do schema.sql, nao o segredo da chave. Nunca ponha aqui a
# service_role key.
#
# A URL e so a origem do projeto -- https://<ref>.supabase.co -- sem barra no
# fim e sem caminho. O painel mostra em destaque o endereco do REST, terminado
# em /rest/v1/; esse nao serve. O cliente anexa /auth/v1 e /rest/v1 sozinho, e
# com o caminho ja embutido o login pede /rest/v1/auth/v1/token e volta com
# "Invalid path specified in request url".
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# O client OAuth *Web*, nao o Android. E a audiencia que o Supabase valida no
# signInWithIdToken; com o id do Android o login passa no aparelho e falha no
# servidor.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
