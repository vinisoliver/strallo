{
  "expo": {
    "name": "Strallo",
    "slug": "strallo",
    "version": "1.1.0",
    "orientation": "portrait",
    "scheme": "strallo",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#131f24",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.strallo.app"
    },
    "android": {
      "package": "com.strallo.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#131f24"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#131f24"
        }
      ],
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f2d6b69d-6736-4a68-a5ee-9d983f33cb77"
      }
    },
    "owner": "vinisoliver"
  }
}
